{
  "name": "inat2exif-web",
  "private": true,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build:vendor": "esbuild web-src/codemirror.js --bundle --format=esm --minify --legal-comments=eof \"--banner:js=/* CodeMirror 6 and @codemirror/lang-jinja, MIT License. See THIRD_PARTY_NOTICES.md. Generated by npm run build:vendor. */\" --target=es2022 --outfile=src/inat2exif/web/vendor/codemirror.js",
    "test": "node --test tests/ui_workflow.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test --test-coverage-include=src/inat2exif/web/app.js --test-coverage-lines=90 tests/ui_workflow.test.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-jinja": "^6.0.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "esbuild": "^0.28.2",
    "jsdom": "^27.4.0"
  }
}
